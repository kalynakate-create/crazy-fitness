{
  // Cloudflare Workers deployment.
  //
  // This is the target where the site is a product rather than a preview: the
  // lead endpoint and the checkout run here, which GitHub Pages cannot do at
  // all. The Pages build stays as the design preview.
  //
  // Stage 18 of the blueprint named Vercel for this role. Cloudflare serves the
  // same purpose; what mattered was a host that runs the API routes, not the
  // specific vendor. Nothing in the code is Cloudflare-specific — the JWT
  // signing moved to WebCrypto precisely so the host stays a choice.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crazy-fitness",
  // Our own entry, which re-exports the generated worker and adds the rate
  // limiting Durable Object. See worker.js for why it is not the generated
  // file directly.
  "main": "worker.js",
  "compatibility_date": "2026-08-15",

  // nodejs_compat is required by the Next.js adapter. The application code
  // itself no longer imports node:crypto; this covers the framework's own use.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // Spam protection for the two POST endpoints.
  //
  // The counters have to be shared across isolates, and they have to be exact.
  // Both cheaper options were measured against this deployment and neither
  // holds: an in-memory Map refused nothing at all, and Cloudflare's built-in
  // rate limiting binding let eleven of twelve requests through a ceiling of
  // three. src/lib/rate-limiter-do.ts records both measurements.
  //
  // SQLite-backed, which is what the free plan provides.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }]

  // Secrets are NOT set here. Put them in the dashboard or via
  // `wrangler secret put <NAME>`, so they never enter the repository:
  //   TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID,
  //   GOOGLE_SHEETS_ID, GOOGLE_SERVICE_ACCOUNT_EMAIL, GOOGLE_PRIVATE_KEY
  // There are no payment secrets: settlement is manual.
}
