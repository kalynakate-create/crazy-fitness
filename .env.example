# Copy to .env.local and fill in. Nothing here is required to run `npm run dev`:
# the site renders without any of it, forms just fail into their Telegram
# fallback, and analytics stays off.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://crazyfitness.com.ua

# --- Telegram notification (Stage 17, Phase 0) ------------------------------
# Create a bot with @BotFather, then send it one message and read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Sheets storage (Stage 18) ---------------------------------------
# Create a service account, enable the Sheets API, then share the spreadsheet
# with the service account email. Two tabs are expected: "Leads" and "Orders".
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the literal \n escapes when pasting into Vercel.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Payments (Stage 7, Monobank is the MVP default) ------------------------
# With a token we create a real invoice per order. Without one, we redirect to
# the static link below, which is enough to start selling.
MONOBANK_TOKEN=
MONOBANK_PAYMENT_URL=

# --- Analytics (Stage 23). Only load after consent. -------------------------
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
